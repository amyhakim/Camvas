{
  "name": "showcam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:backend": "node scripts/check-backend.mjs",
    "test:collaboration": "node scripts/check-collaboration.mjs",
    "test:ui": "node scripts/check-live.mjs && node scripts/check-ui.mjs",
    "export:scene": "blender --background --factory-startup --disable-autoexec --python-exit-code 1 pabellon_barcelona_v1.scene_/3d/pavillon_barcelone_v1.2.blend --python scripts/export-scene.py",
    "test:room-tools": "node scripts/check-room-tools.mjs",
    "test:overlay": "node scripts/check-overlay.mjs",
    "test:camera": "node scripts/check-camera-engine.mjs && node scripts/check-camera-authoring.mjs",
    "test:modules": "node scripts/check-modules.mjs",
    "test:workstreams": "node --test scripts/workstreams/cli.test.mjs",
    "worktree": "node scripts/workstreams/cli.mjs",
    "test:projects": "node scripts/check-project-blocking.mjs",
    "test:objects": "node scripts/check-object-controls.mjs",
    "test:splats": "node scripts/check-splats.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "^16.3.6",
    "playcanvas": "^2.22.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
