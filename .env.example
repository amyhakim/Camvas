# Server-only Gemini API key. Never expose this with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CinemaTraj-compatible worker base URL and optional bearer token.
# On Railway, prefer a private URL such as http://gpu-worker.railway.internal:8000.
GPU_WORKER_URL=
GPU_WORKER_TOKEN=

# Server-only Sketchfab API token (sketchfab.com > Settings > Password & API). Enables the Director and
# the Props panel to download free Creative Commons models. Search works without it; downloads do not.
# Never expose this with a NEXT_PUBLIC_ prefix.
SKETCHFAB_API_TOKEN=
# Optional: largest archive to download, in MB (default 40), and where unpacked models are cached.
SKETCHFAB_MAX_MB=40
SKETCHFAB_CACHE_DIR=

# Optional comma-separated custom y-webrtc signaling servers.
# Omit for the public prototype signaling service.
NEXT_PUBLIC_COLLAB_SIGNALING_URLS=
