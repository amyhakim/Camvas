# Server-only Gemini API key. Never expose this with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CinemaTraj-compatible worker base URL and optional bearer token.
# On Railway, prefer a private URL such as http://gpu-worker.railway.internal:8000.
GPU_WORKER_URL=
GPU_WORKER_TOKEN=

# Optional comma-separated custom y-webrtc signaling servers.
# Omit for the public prototype signaling service.
NEXT_PUBLIC_COLLAB_SIGNALING_URLS=
